@model AquaGuard.Web.ViewModels.WaterSourceFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit water source" : "Add water source";
}
<div class="page-header"><div><a class="back-link" asp-action="Sources"><i data-lucide="arrow-left"></i> Water sources</a><h1>@(isEdit ? "Edit source" : "Add a water source")</h1></div></div>
<form asp-action="@(isEdit ? "EditSource" : "CreateSource")" asp-route-id="@Model.Id" method="post" class="panel-card workspace-form narrow-form">
    <input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="form-grid">
        <div class="field-span-2"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
        <div><label asp-for="VillageId" class="form-label"></label><select asp-for="VillageId" asp-items="ViewBag.Villages" class="form-select"><option value="">Choose village</option></select><span asp-validation-for="VillageId" class="field-validation-error"></span></div>
        <div><label asp-for="SourceType" class="form-label"></label><select asp-for="SourceType" asp-items="Html.GetEnumSelectList<AquaGuard.Domain.Enums.WaterSourceType>()" class="form-select"></select></div>
        <div><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" type="number" step="0.000001" /></div>
        <div><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" type="number" step="0.000001" /></div>
        <div class="field-span-2"><label asp-for="LocationDescription" class="form-label"></label><textarea asp-for="LocationDescription" class="form-control" rows="2"></textarea></div>
        <div class="field-span-2"><label class="form-check"><input asp-for="IsActive" class="form-check-input" /><span class="form-check-label">Available for new test reports</span></label></div>
    </div>
    <div class="form-actions"><a class="btn btn-outline" asp-action="Sources">Cancel</a><button class="btn btn-primary" type="submit">Save water source</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
