@model AquaGuard.Web.ViewModels.WaterSourcesViewModel
@{
    ViewData["Title"] = "Water sources";
}
<div class="page-header"><div><a class="back-link" asp-action="Index"><i data-lucide="arrow-left"></i> Water quality</a><h1>Water sources</h1><p>Maintain the monitored sources linked to community test reports.</p></div><a class="btn btn-primary" asp-action="CreateSource"><i data-lucide="plus"></i> Add source</a></div>
<section class="panel-card">
    <div class="table-responsive"><table class="data-table"><thead><tr><th>Source</th><th>Village</th><th>Type</th><th>Test reports</th><th>Status</th><th></th></tr></thead><tbody>
    @if (Model.Sources.Count == 0) { <tr><td colspan="6"><div class="empty-state"><i data-lucide="droplets"></i><p>No water sources are configured.</p></div></td></tr> }
    else { @foreach (var source in Model.Sources) { <tr><td><strong>@source.Name</strong><small class="d-block text-secondary">@source.LocationDescription</small></td><td>@source.Village.Name</td><td>@source.SourceType</td><td>@source.QualityReports.Count</td><td><span class="badge @(source.IsActive ? "badge-safe" : "badge-pending")">@(source.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><a class="btn btn-outline btn-sm" asp-action="EditSource" asp-route-id="@source.Id">Edit</a><form asp-action="DeleteSource" asp-route-id="@source.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this source? Existing test history prevents deletion.')"><button class="btn btn-quiet btn-sm text-danger" type="submit">Delete</button></form></td></tr> } }
    </tbody></table></div>
</section>
