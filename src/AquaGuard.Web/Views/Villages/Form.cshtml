@model AquaGuard.Web.ViewModels.VillageFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit village" : "Add village";
}
<div class="page-header"><div><a class="back-link" asp-action="Index"><i data-lucide="arrow-left"></i> Villages</a><h1>@(isEdit ? "Edit community" : "Add a community")</h1><p>Keep location and population details up to date.</p></div></div>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="panel-card workspace-form">
    <input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="form-grid">
        <div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
        <div><label asp-for="DistrictId" class="form-label"></label><select asp-for="DistrictId" asp-items="ViewBag.Districts" class="form-select"><option value="">Choose district</option></select><span asp-validation-for="DistrictId" class="field-validation-error"></span></div>
        <div><label asp-for="Population" class="form-label"></label><input asp-for="Population" class="form-control" min="0" /><span asp-validation-for="Population" class="field-validation-error"></span></div>
        <div><label asp-for="HouseholdCount" class="form-label"></label><input asp-for="HouseholdCount" class="form-control" min="0" /></div>
        <div><label asp-for="AssignedHealthWorkerId" class="form-label"></label><select asp-for="AssignedHealthWorkerId" asp-items="ViewBag.HealthWorkers" class="form-select"><option value="">No assignment</option></select></div>
        <div><label asp-for="AvailableHealthFacilities" class="form-label"></label><input asp-for="AvailableHealthFacilities" class="form-control" /></div>
        <div><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" type="number" step="0.000001" /></div>
        <div><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" type="number" step="0.000001" /></div>
    </div>
    <div class="form-actions"><a class="btn btn-outline" asp-action="Index">Cancel</a><button type="submit" class="btn btn-primary">Save village</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
