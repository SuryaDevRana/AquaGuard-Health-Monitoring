@model AquaGuard.Web.ViewModels.WarningsIndexViewModel
@using AquaGuard.Domain.Enums
@{
    ViewData["Title"] = "Early warnings";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<div class="page-header warning-page-header">
    <div>
        <span class="eyebrow text-teal"><i data-lucide="activity"></i> Human-reviewed signals</span>
        <h1>Early warnings</h1>
        <p>Spot emerging patterns and route them for timely, evidence-led review.</p>
    </div>
    <div class="warning-header-actions">
        <a class="btn btn-outline" asp-action="Create"><i data-lucide="send"></i> Send a warning</a>
        <form asp-action="Evaluate" method="post">
            <button class="btn btn-primary" type="submit" data-loading-text="Checking recent data…">
                <i data-lucide="scan-search"></i><span>Evaluate recent data</span>
            </button>
        </form>
    </div>
</div>

<div class="warning-safety-banner">
    <span class="warning-safety-icon"><i data-lucide="shield-check"></i></span>
    <div><strong>Decision support, not diagnosis</strong><span>Signals are generated by transparent rules and require human review. They do not confirm an outbreak or replace public-health judgment.</span></div>
</div>

<section class="stat-grid warning-stat-grid" aria-label="Warning summary">
    <article class="stat-card warning-stat-card">
        <div class="stat-card-top"><span class="label">Active signals</span><span class="mini-icon teal"><i data-lucide="activity"></i></span></div>
        <div class="value">@Model.ActiveCount</div><span class="trend">Open or acknowledged</span>
    </article>
    <article class="stat-card warning-stat-card">
        <div class="stat-card-top"><span class="label">Awaiting review</span><span class="mini-icon amber"><i data-lucide="eye"></i></span></div>
        <div class="value">@Model.OpenCount</div><span class="trend">Not yet acknowledged</span>
    </article>
    <article class="stat-card warning-stat-card">
        <div class="stat-card-top"><span class="label">Acknowledged</span><span class="mini-icon blue"><i data-lucide="clipboard-check"></i></span></div>
        <div class="value">@Model.AcknowledgedCount</div><span class="trend">Under human review</span>
    </article>
    <article class="stat-card warning-stat-card warning-critical-stat">
        <div class="stat-card-top"><span class="label">Critical active</span><span class="mini-icon red"><i data-lucide="triangle-alert"></i></span></div>
        <div class="value">@Model.CriticalCount</div><span class="trend alert">Prompt review recommended</span>
    </article>
</section>

<section class="panel-card warning-queue">
    <div class="warning-queue-heading">
        <div><span class="eyebrow">Review workspace</span><h2>Warning queue</h2><p class="panel-subtitle">Prioritized by status, then risk level and date.</p></div>
        <span class="warning-match-count">@Model.TotalCount matching @(Model.TotalCount == 1 ? "signal" : "signals")</span>
    </div>

    <form asp-action="Index" method="get" class="warning-filter-form" data-auto-filter>
        <label class="warning-search-field">
            <span class="visually-hidden">Search warnings</span>
            <i data-lucide="search"></i>
            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Search alert, village, or trigger…" maxlength="100" />
        </label>
        <label class="visually-hidden" for="warningStatus">Filter by status</label>
        <select id="warningStatus" class="form-select" name="status">
            <option value="">All statuses</option>
            @foreach (var value in Enum.GetValues<WarningStatus>())
            {
                <option value="@value" selected="@(Model.Status == value)">@value</option>
            }
        </select>
        <label class="visually-hidden" for="warningRisk">Filter by risk</label>
        <select id="warningRisk" class="form-select" name="riskLevel">
            <option value="">All risk levels</option>
            @foreach (var value in Enum.GetValues<RiskLevel>().OrderByDescending(x => (int)x))
            {
                <option value="@value" selected="@(Model.RiskLevel == value)">@value</option>
            }
        </select>
        <label class="visually-hidden" for="warningVillage">Filter by village</label>
        <select id="warningVillage" class="form-select" name="villageId">
            <option value="">All villages</option>
            @foreach (var village in Model.Villages)
            {
                <option value="@village.Id" selected="@(Model.VillageId == village.Id)">@village.Name</option>
            }
        </select>
        <button class="btn btn-primary warning-filter-submit" type="submit"><i data-lucide="list-filter"></i> Filter</button>
        @if (Model.Search is not null || Model.Status.HasValue || Model.RiskLevel.HasValue || Model.VillageId.HasValue)
        {
            <a class="btn btn-quiet warning-clear-filter" asp-action="Index">Clear</a>
        }
    </form>

    <nav class="warning-quick-filters" aria-label="Quick status filters">
        <a class="@(Model.Status is null ? "active" : "")" asp-action="Index" asp-route-search="@Model.Search" asp-route-riskLevel="@Model.RiskLevel" asp-route-villageId="@Model.VillageId">All signals</a>
        <a class="@(Model.Status == WarningStatus.Open ? "active" : "")" asp-action="Index" asp-route-status="@WarningStatus.Open" asp-route-search="@Model.Search" asp-route-riskLevel="@Model.RiskLevel" asp-route-villageId="@Model.VillageId">Open <span>@Model.MatchingOpenCount</span></a>
        <a class="@(Model.Status == WarningStatus.Acknowledged ? "active" : "")" asp-action="Index" asp-route-status="@WarningStatus.Acknowledged" asp-route-search="@Model.Search" asp-route-riskLevel="@Model.RiskLevel" asp-route-villageId="@Model.VillageId">Acknowledged <span>@Model.MatchingAcknowledgedCount</span></a>
    </nav>

    @if (Model.Warnings.Count == 0)
    {
        <div class="warning-empty-state">
            <span><i data-lucide="shield-check"></i></span>
            <h3>@(Model.TotalCount == 0 ? "No warnings to review" : "No signals match these filters")</h3>
            <p>@(Model.TotalCount == 0 ? "Evaluate recent reports to check for configured early-warning signals." : "Try changing the search text or selecting different filters.")</p>
            @if (Model.TotalCount > 0)
            {
                <a class="btn btn-outline" asp-action="Index">Reset filters</a>
            }
        </div>
    }
    else
    {
        <div class="warning-card-list">
            @foreach (var warning in Model.Warnings)
            {
                var active = warning.Status is WarningStatus.Open or WarningStatus.Acknowledged;
                <article class="warning-card warning-card-@warning.RiskLevel.ToString().ToLowerInvariant()">
                    <div class="warning-card-marker"><i data-lucide="@(warning.RiskLevel == RiskLevel.Critical ? "triangle-alert" : "activity")"></i></div>
                    <div class="warning-card-content">
                        <div class="warning-card-topline">
                            <span class="warning-alert-code">@warning.AlertCode</span>
                            <span class="warning-card-date">@warning.AlertDate.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</span>
                        </div>
                        <h3><a asp-action="Details" asp-route-id="@warning.Id">@warning.Village.Name</a><span class="warning-card-separator">·</span>@(warning.RelatedDisease?.Name ?? "Water quality signal")</h3>
                        <p class="warning-trigger">@warning.TriggerReason</p>
                        <div class="warning-card-meta">
                            <span class="badge badge-@warning.RiskLevel.ToString().ToLowerInvariant()">@warning.RiskLevel risk</span>
                            <span class="badge badge-@warning.Status.ToString().ToLowerInvariant()">@warning.Status</span>
                            <span class="warning-case-count"><i data-lucide="users-round"></i>@warning.ReportedCaseCount related cases</span>
                        </div>
                    </div>
                    <div class="warning-card-actions">
                        <a class="btn btn-outline btn-sm" asp-action="Details" asp-route-id="@warning.Id">Review details</a>
                        @if (active && warning.Status == WarningStatus.Open)
                        {
                            <form asp-action="SetStatus" asp-route-id="@warning.Id" method="post">
                                <input type="hidden" name="status" value="@WarningStatus.Acknowledged" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button class="btn btn-quiet btn-sm" type="submit"><i data-lucide="eye"></i> Acknowledge</button>
                            </form>
                        }
                        @if (active)
                        {
                            <form asp-action="SetStatus" asp-route-id="@warning.Id" method="post" onsubmit="return confirm('Mark this warning as resolved?')">
                                <input type="hidden" name="status" value="@WarningStatus.Resolved" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button class="btn btn-quiet btn-sm" type="submit"><i data-lucide="check"></i> Resolve</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
        @if (Model.TotalCount > Model.Warnings.Count)
        {
            <p class="warning-list-limit">Showing the top @Model.Warnings.Count of @Model.TotalCount matching signals. Refine the filters to narrow the queue.</p>
        }
    }
</section>
