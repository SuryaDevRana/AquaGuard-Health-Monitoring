<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AquaGuard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-shell">
        <section class="auth-panel">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i data-lucide="waves"></i></span>AquaGuard</a>
            <div class="auth-form-wrap">@RenderBody()</div>
        </section>
        <aside class="auth-aside">
            <div class="auth-illustration">
                <span class="eyebrow text-teal">Community intelligence</span>
                <h1>Every water point. Every health signal. One clearer picture.</h1>
                <p>Bring local health workers, water-quality observations, and responsible early warnings together in one calm workspace.</p>
                <div class="auth-metric-card"><span class="metric-icon"><i data-lucide="shield-check"></i></span><div><strong>Privacy-led monitoring</strong><small>Built to support human review, never replace it.</small></div></div>
            </div>
        </aside>
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
