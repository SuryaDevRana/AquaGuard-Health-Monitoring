@model AquaGuard.Web.ViewModels.PatientFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit patient" : "Add patient";
}
<div class="page-header">
    <div><a class="back-link" asp-action="Index"><i data-lucide="arrow-left"></i> Patient records</a><h1>@(isEdit ? "Update patient record" : "Add a patient")</h1><p>Capture only the information needed for this demonstration workspace.</p></div>
</div>
<div class="form-layout">
    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="panel-card workspace-form">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <h2 class="form-section-title">Personal details</h2>
        <div class="form-grid">
            <div class="field-span-2"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName" class="field-validation-error"></span></div>
            <div><label asp-for="Age" class="form-label"></label><input asp-for="Age" class="form-control" min="0" max="120" /><span asp-validation-for="Age" class="field-validation-error"></span></div>
            <div><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" asp-items="Html.GetEnumSelectList<AquaGuard.Domain.Enums.Gender>()" class="form-select"></select></div>
            <div><label asp-for="VillageId" class="form-label"></label><select asp-for="VillageId" asp-items="ViewBag.Villages" class="form-select"><option value="">Choose village</option></select><span asp-validation-for="VillageId" class="field-validation-error"></span></div>
            <div><label asp-for="DiseaseId" class="form-label"></label><select asp-for="DiseaseId" asp-items="ViewBag.Diseases" class="form-select"><option value="">Not specified</option></select></div>
            <div><label asp-for="ContactNumber" class="form-label"></label><input asp-for="ContactNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="ContactNumber" class="field-validation-error"></span></div>
            <div class="field-span-2"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" autocomplete="street-address" /></div>
            <div class="field-span-2"><label asp-for="Symptoms" class="form-label"></label><textarea asp-for="Symptoms" class="form-control" rows="3"></textarea><span asp-validation-for="Symptoms" class="field-validation-error"></span></div>
        </div>
        <div class="form-actions"><a class="btn btn-outline" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit"><i data-lucide="check"></i> @(isEdit ? "Save changes" : "Create patient record")</button></div>
    </form>
    <aside class="panel-card form-aside"><span class="mini-icon teal"><i data-lucide="shield-check"></i></span><h2>Keep records responsible</h2><p>This app currently uses simulated demonstration records. Avoid adding identifiable or real health information.</p></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
