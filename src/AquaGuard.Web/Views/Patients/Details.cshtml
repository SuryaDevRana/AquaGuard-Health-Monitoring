@model AquaGuard.Application.Patients.PatientDetail
@{
    ViewData["Title"] = "Patient details";
}
<div class="page-header">
    <div><a class="back-link" asp-action="Index"><i data-lucide="arrow-left"></i> Patient records</a><h1>@Model.FullName</h1><p>@Model.PatientCode · Registered @Model.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy")</p></div>
    <div class="d-flex gap-2"><a class="btn btn-outline" asp-action="Edit" asp-route-id="@Model.Id"><i data-lucide="pencil"></i> Edit</a><form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this patient record and its report history?')"><button class="btn btn-danger" type="submit"><i data-lucide="trash-2"></i> Delete</button></form></div>
</div>
<div class="demo-banner"><i data-lucide="flask-conical"></i><span>Demonstration patient record. Do not use this sample application to store real patient information.</span></div>
<section class="two-col">
    <article class="panel-card"><div class="panel-head"><h2>Profile</h2></div><dl class="detail-grid">
        <div><dt>Age</dt><dd>@Model.Age</dd></div><div><dt>Gender</dt><dd>@Model.Gender</dd></div>
        <div><dt>Village</dt><dd>@Model.Village</dd></div><div><dt>Reported disease</dt><dd>@(Model.Disease ?? "Not specified")</dd></div>
        <div><dt>Contact</dt><dd>@(Model.ContactNumber ?? "Not provided")</dd></div><div><dt>Address</dt><dd>@(Model.Address ?? "Not provided")</dd></div>
        <div class="detail-span"><dt>Symptoms noted</dt><dd>@(Model.Symptoms ?? "No symptoms recorded")</dd></div>
    </dl></article>
    <article class="panel-card"><div class="panel-head"><h2>Report history</h2><span class="badge badge-low">@Model.History.Count records</span></div>
        @if (Model.History.Count == 0) { <div class="empty-state"><i data-lucide="clipboard-list"></i><p>No case reports have been recorded for this patient.</p></div> }
        else { <div class="timeline-list">@foreach (var item in Model.History) { <article class="timeline-item"><span class="timeline-dot"></span><div><div class="d-flex justify-content-between gap-2"><strong>@item.Disease</strong><small class="text-secondary">@item.ReportedOn.ToLocalTime().ToString("dd MMM yyyy")</small></div><p>@item.Symptoms</p><span class="badge badge-pending">@item.Severity</span>@if (!string.IsNullOrWhiteSpace(item.Notes)) { <small class="d-block mt-2 text-secondary">@item.Notes</small> }</div></article>}</div> }
    </article>
</section>
