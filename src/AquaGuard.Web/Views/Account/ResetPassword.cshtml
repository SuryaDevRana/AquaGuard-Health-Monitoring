@model AquaGuard.Web.ViewModels.Account.ResetPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Choose a new password"; }
<div><span class="eyebrow text-teal">Account recovery</span><h1 class="auth-title mt-2">Choose a new password</h1><p class="auth-subtitle">Use a strong, unique password for your account.</p></div>
<form asp-action="ResetPassword" method="post" class="mt-4"><input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" /><div asp-validation-summary="ModelOnly" class="mb-3"></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span></div><div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary w-100" type="submit">Reset password <i data-lucide="key-round"></i></button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
