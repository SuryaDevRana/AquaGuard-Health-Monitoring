@model AquaGuard.Web.ViewModels.Account.RegisterViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Create an account"; }
<div><span class="eyebrow text-teal">Healthcare worker access</span><h1 class="auth-title mt-2">Create your account</h1><p class="auth-subtitle">Start recording and reviewing community health observations.</p></div>
<form asp-action="Register" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="mb-3"></div><div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Your full name" /><span asp-validation-for="FullName"></span></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@organisation.org" /><span asp-validation-for="Email"></span></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><div class="form-text">At least 10 characters, including uppercase, lowercase, number, and symbol.</div><span asp-validation-for="Password"></span></div><div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary w-100" type="submit">Create account <i data-lucide="arrow-right"></i></button></form>
<p class="auth-switch">Already have access? <a asp-action="Login">Sign in</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
