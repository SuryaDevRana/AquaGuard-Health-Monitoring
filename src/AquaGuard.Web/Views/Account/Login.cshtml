@model AquaGuard.Web.ViewModels.Account.LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Welcome back"; }
<div><span class="eyebrow text-teal">Secure sign in</span><h1 class="auth-title mt-2">Welcome back</h1><p class="auth-subtitle">Sign in to review your community health workspace.</p></div>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success" data-dismiss-after>@message</div> }
<form asp-action="Login" method="post" class="mt-4"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="mb-3"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@organisation.org" /><span asp-validation-for="Email"></span></div><div class="mb-2"><div class="d-flex justify-content-between"><label asp-for="Password" class="form-label"></label><a class="small text-teal fw-semibold" asp-action="ForgotPassword">Forgot password?</a></div><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password"></span></div><label class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><span class="form-check-label">Keep me signed in</span></label><button class="btn btn-primary w-100" type="submit">Sign in <i data-lucide="arrow-right"></i></button></form>
<p class="auth-switch">New to AquaGuard? <a asp-action="Register">Create a healthcare worker account</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
