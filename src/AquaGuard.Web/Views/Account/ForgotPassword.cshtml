@model AquaGuard.Web.ViewModels.Account.ForgotPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Reset password"; }
<div><span class="eyebrow text-teal">Account recovery</span><h1 class="auth-title mt-2">Reset your password</h1><p class="auth-subtitle">Enter your registered email and we’ll send a secure reset link.</p></div>
<form asp-action="ForgotPassword" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="mb-3"></div><div class="mb-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@organisation.org" /><span asp-validation-for="Email"></span></div><button class="btn btn-primary w-100" type="submit">Send reset link <i data-lucide="send"></i></button></form>
<p class="auth-switch"><a asp-action="Login">Back to sign in</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
