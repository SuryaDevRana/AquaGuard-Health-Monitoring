@using System.Text.Json
@using AquaGuard.Application.Dashboard
@model DashboardSummary
@{ ViewData["Title"] = "Community overview"; var chartOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web); }
<div class="page-header"><div><h1>Good morning, @User.Identity?.Name?.Split('@')[0]</h1><p>Here’s your community health overview.</p></div><div class="d-flex gap-2"><a class="btn btn-outline" asp-controller="Reports" asp-action="Index"><i data-lucide="download"></i> Export</a><a class="btn btn-primary" asp-controller="EarlyWarnings" asp-action="Index"><i data-lucide="siren"></i> Review alerts</a></div></div>
<div class="demo-banner"><i data-lucide="flask-conical"></i><span><strong>Demonstration data:</strong> The information shown is simulated for product demonstration and must not be treated as actual public-health surveillance.</span></div>
<section class="stat-grid"><article class="stat-card"><div class="stat-card-top"><span class="label">Total villages</span><span class="mini-icon teal"><i data-lucide="map-pin"></i></span></div><div class="value">@Model.TotalVillages</div><span class="trend up"><i data-lucide="check"></i> Monitored communities</span></article><article class="stat-card"><div class="stat-card-top"><span class="label">Registered patients</span><span class="mini-icon blue"><i data-lucide="users-round"></i></span></div><div class="value">@Model.RegisteredPatients</div><span class="trend up"><i data-lucide="arrow-up-right"></i> Records in workspace</span></article><article class="stat-card"><div class="stat-card-top"><span class="label">Reported disease cases</span><span class="mini-icon amber"><i data-lucide="activity"></i></span></div><div class="value">@Model.DiseaseCases</div><span class="trend alert"><i data-lucide="info"></i> Review trends, not diagnoses</span></article><article class="stat-card"><div class="stat-card-top"><span class="label">Active health alerts</span><span class="mini-icon red"><i data-lucide="siren"></i></span></div><div class="value">@Model.ActiveAlerts</div><span class="trend alert"><i data-lucide="eye"></i> Awaiting human review</span></article></section>
<section class="dashboard-grid"><article class="panel-card"><div class="panel-head"><h2>Disease cases over time</h2><span class="small text-secondary">Last 28 days</span></div><div class="chart-wrap"><canvas id="diseaseTrendChart"></canvas></div></article><article class="panel-card"><div class="panel-head"><h2>Disease distribution</h2><span class="small text-secondary">Reported cases</span></div><div class="chart-wrap"><canvas id="diseaseDistributionChart"></canvas></div></article></section>
<section class="dashboard-grid"><article class="panel-card"><div class="panel-head"><h2>Water quality trends</h2><span class="small text-secondary">pH and turbidity</span></div><div class="chart-wrap"><canvas id="waterTrendChart"></canvas></div></article><article class="panel-card"><div class="panel-head"><h2>Village-wise risk</h2><span class="small text-secondary">Open signals</span></div><div class="chart-wrap"><canvas id="villageRiskChart"></canvas></div></article></section>
<section class="two-col"><article class="panel-card"><div class="panel-head"><h2>Recent patient reports</h2><a asp-controller="Patients" asp-action="Index">View records <i data-lucide="arrow-right"></i></a></div><div class="table-responsive"><table class="data-table"><thead><tr><th>Patient</th><th>Disease</th><th>Village</th><th>Recorded</th></tr></thead><tbody>@foreach (var report in Model.RecentPatientReports) { <tr><td><strong>@report.PatientName</strong></td><td>@report.Disease</td><td>@report.Village</td><td>@report.ReportedOn.ToString("dd MMM")</td></tr> }</tbody></table></div></article><article class="panel-card"><div class="panel-head"><h2>Latest water reports</h2><a asp-controller="WaterQuality" asp-action="Index">View quality <i data-lucide="arrow-right"></i></a></div><div class="table-responsive"><table class="data-table"><thead><tr><th>Source</th><th>Village</th><th>Status</th><th>Tested</th></tr></thead><tbody>@foreach (var report in Model.RecentWaterReports) { <tr><td><strong>@report.SourceName</strong></td><td>@report.Village</td><td><span class="badge badge-@report.Status.ToLowerInvariant().Replace(" ", "-")">@report.Status@(report.IsEstimated ? " · Est." : "")</span></td><td>@report.TestedOn.ToString("dd MMM")</td></tr> }</tbody></table></div></article></section>
<section class="two-col"><article class="panel-card"><div class="panel-head"><h2>Active outbreak-review warnings</h2><a asp-controller="EarlyWarnings" asp-action="Index">All alerts <i data-lucide="arrow-right"></i></a></div>@if (Model.ActiveWarnings.Count == 0) { <div class="empty-state"><i data-lucide="shield-check"></i><p>No active rule-based warnings.</p></div> } else { <div class="table-responsive"><table class="data-table"><thead><tr><th>Alert</th><th>Village</th><th>Risk</th><th>Date</th></tr></thead><tbody>@foreach (var warning in Model.ActiveWarnings) { <tr><td><strong>@warning.AlertCode</strong><br /><small>@warning.TriggerReason</small></td><td>@warning.Village</td><td><span class="badge badge-@warning.RiskLevel.ToLowerInvariant()">@warning.RiskLevel</span></td><td>@warning.AlertDate.ToString("dd MMM")</td></tr> }</tbody></table></div>}</article><article class="panel-card"><div class="panel-head"><h2>Recent activity</h2></div><div class="activity-list">@foreach (var activity in Model.Activities) { <div class="d-flex gap-3 py-2 border-bottom"><span class="mini-icon teal"><i data-lucide="circle-check"></i></span><div><strong class="d-block small">@activity.Title</strong><span class="small text-secondary">@activity.Detail · @activity.OccurredAt.ToString("dd MMM, HH:mm")</span></div></div> }</div></article></section>
@section Scripts { <script>
const aquaColors = { navy: '#102A43', teal: '#0D9488', tealSoft: '#A7DDD7', amber: '#F59E0B', red: '#DC2626', grid:'#E5EAF0' };
const diseaseTrend = @Html.Raw(JsonSerializer.Serialize(Model.DiseaseTrend, chartOptions));
const distribution = @Html.Raw(JsonSerializer.Serialize(Model.DiseaseDistribution, chartOptions));
const waterTrend = @Html.Raw(JsonSerializer.Serialize(Model.WaterQualityTrend, chartOptions));
const villageRisks = @Html.Raw(JsonSerializer.Serialize(Model.VillageRisks, chartOptions));
const shared = { responsive:true, maintainAspectRatio:false, plugins:{legend:{labels:{usePointStyle:true,boxWidth:7,font:{family:'Inter',size:11}}}}, scales:{x:{grid:{display:false},ticks:{font:{family:'Inter',size:10},maxTicksLimit:7}},y:{border:{display:false},grid:{color:aquaColors.grid},ticks:{font:{family:'Inter',size:10},precision:0}}} };
new Chart(document.getElementById('diseaseTrendChart'), { type:'line', data:{labels:diseaseTrend.map(x=>x.label),datasets:[{label:'Reported cases',data:diseaseTrend.map(x=>x.value),borderColor:aquaColors.teal,backgroundColor:'rgba(13,148,136,.09)',fill:true,tension:.38,pointRadius:0,borderWidth:2.5}]},options:shared });
new Chart(document.getElementById('diseaseDistributionChart'), { type:'doughnut', data:{labels:distribution.map(x=>x.label),datasets:[{data:distribution.map(x=>x.value),backgroundColor:['#0D9488','#3B82F6','#F59E0B','#8B5CF6','#EF7C6D','#718096'],borderWidth:0,spacing:3}]},options:{responsive:true,maintainAspectRatio:false,cutout:'68%',plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:7,font:{family:'Inter',size:11}}}}} });
new Chart(document.getElementById('waterTrendChart'), { type:'line', data:{labels:waterTrend.map(x=>x.label),datasets:[{label:'Average pH',data:waterTrend.map(x=>x.value),borderColor:aquaColors.teal,tension:.35,pointRadius:3,borderWidth:2},{label:'Turbidity (NTU)',data:waterTrend.map(x=>x.secondaryValue),borderColor:aquaColors.amber,tension:.35,pointRadius:3,borderWidth:2}]},options:shared });
new Chart(document.getElementById('villageRiskChart'), { type:'bar', data:{labels:villageRisks.map(x=>x.label),datasets:[{label:'Open signals',data:villageRisks.map(x=>x.value),backgroundColor:villageRisks.map(x=>x.status==='Critical'?aquaColors.red:x.status==='High'?aquaColors.amber:aquaColors.teal),borderRadius:6,borderSkipped:false}]},options:{...shared,indexAxis:'y',plugins:{legend:{display:false}}} });
</script> }
